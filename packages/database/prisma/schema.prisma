datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERADMIN
  OWNER
  ADMIN
  CASHIER
  WAITER
  KITCHEN
  DRIVER
}

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
  WHATSAPP
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

model Plan {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  monthlyPrice Decimal  @db.Decimal(12, 2)
  featureFlags Json
  tenants      Tenant[]
}

model Tenant {
  id                 String   @id @default(uuid())
  name               String
  slug               String   @unique
  customDomain       String?  @unique
  currency           String   @default("COP")
  whatsappPhone      String?
  themeConfig        Json     @default("{}")
  planId             String
  plan               Plan     @relation(fields: [planId], references: [id])
  subscriptionStatus String   @default("ACTIVE")
  createdAt          DateTime @default(now())

  branches       Branch[]
  members        TenantMember[]
  categories     Category[]
  products       Product[]
  modifierGroups ModifierGroup[]
  orders         Order[]
}

model Branch {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  address       String?
  latitude      Decimal?      @db.Decimal(10, 7)
  longitude     Decimal?      @db.Decimal(10, 7)
  deliveryZones Json          @default("[]")
  isOpen        Boolean       @default(true)
  tables        DiningTable[]
  orders        Order[]

  @@index([tenantId])
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  fullName     String
  memberships  TenantMember[]
  createdAt    DateTime       @default(now())
}

model TenantMember {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId String?
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role

  @@unique([tenantId, userId])
}

model Category {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  products  Product[]

  @@index([tenantId, sortOrder])
}

model Product {
  id          String                 @id @default(uuid())
  tenantId    String
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  basePrice   Decimal                @db.Decimal(12, 2)
  images      String[]
  isAvailable Boolean                @default(true)
  trackStock  Boolean                @default(false)
  stockQty    Decimal                @default(0) @db.Decimal(10, 2)
  modifiers   ProductModifierGroup[]

  @@index([tenantId, categoryId])
}

model ModifierGroup {
  id        String                 @id @default(uuid())
  tenantId  String
  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  minSelect Int                    @default(0)
  maxSelect Int                    @default(1)
  options   ModifierOption[]
  products  ProductModifierGroup[]

  @@index([tenantId])
}

model ProductModifierGroup {
  productId       String
  modifierGroupId String
  sortOrder       Int           @default(0)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([productId, modifierGroupId])
}

model ModifierOption {
  id          String        @id @default(uuid())
  tenantId    String
  groupId     String
  group       ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name        String
  priceDelta  Decimal       @default(0) @db.Decimal(12, 2)
  isAvailable Boolean       @default(true)

  @@index([tenantId, groupId])
}

model DiningTable {
  id       String  @id @default(uuid())
  tenantId String
  branchId String
  branch   Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name     String
  qrToken  String  @unique @default(cuid())
  orders   Order[]

  @@index([tenantId, branchId])
}

model Order {
  id                String       @id @default(uuid())
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id])
  branchId          String
  branch            Branch       @relation(fields: [branchId], references: [id])
  orderNumber       Int
  clientGeneratedId String?      @unique
  type              OrderType
  status            OrderStatus  @default(PENDING)
  tableId           String?
  table             DiningTable? @relation(fields: [tableId], references: [id])
  customerName      String?
  customerPhone     String?
  deliveryAddress   String?
  subtotal          Decimal      @db.Decimal(12, 2)
  deliveryFee       Decimal      @default(0) @db.Decimal(12, 2)
  discountTotal     Decimal      @default(0) @db.Decimal(12, 2)
  taxTotal          Decimal      @default(0) @db.Decimal(12, 2)
  total             Decimal      @db.Decimal(12, 2)
  notes             String?
  items             OrderItem[]
  createdAt         DateTime     @default(now())

  @@index([tenantId, branchId, status])
  @@index([tenantId, createdAt])
}

model OrderItem {
  id                  String              @id @default(uuid())
  tenantId            String
  orderId             String
  order               Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  productNameSnapshot String
  unitPrice           Decimal             @db.Decimal(12, 2)
  quantity            Int
  notes               String?
  isPrepared          Boolean             @default(false)
  modifiers           OrderItemModifier[]

  @@index([orderId])
}

model OrderItemModifier {
  id                   String    @id @default(uuid())
  orderItemId          String
  orderItem            OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierNameSnapshot String
  priceDelta           Decimal   @db.Decimal(12, 2)
  quantity             Int       @default(1)
}
